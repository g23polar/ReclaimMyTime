# Local live-integration settings (T6.1). Copy to `server/.env` (gitignored) and fill in.
# Load before starting the server:  set -a; source .env; set +a; uvicorn app.main:app --reload

# --- Database (local Postgres) -------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://postgres@localhost:54329/reclaim_dev

# --- Token encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
AUTH_FERNET_KEYS=1:<fernet-key>
GCAL_STATE_KEY=<a different fernet-key>

# --- Google: sign-in AND Calendar (REQUIRED) ----------------------------------------
# One OAuth web client serves both Google sign-in (POST /auth/google/*, T6.0) and the
# calendar connection; Calendar API enabled. Register exactly one redirect URI:
# GOOGLE_REDIRECT_URI (our GET /gcal/callback). GCAL_STATE_KEY above encrypts both flows' state.
GOOGLE_CLIENT_ID=<...apps.googleusercontent.com>
GOOGLE_CLIENT_SECRET=<client secret>
GOOGLE_REDIRECT_URI=http://localhost:8000/gcal/callback
# Optional app callback URLs (defaults shown); must not carry a query or fragment.
# GCAL_APP_CALLBACK_URL=reclaimmytime://gcal/callback
# GOOGLE_LOGIN_APP_CALLBACK_URL=reclaimmytime://auth/google/callback

# --- Sign in with Apple (OPTIONAL; needs a paid Apple Developer membership) -----------
# Leave every APPLE_* variable unset to run without Apple: the server starts normally and
# POST /auth/apple answers 503 apple_unavailable. A partial set (e.g. a bundle id without
# the key, or a key without a bundle id) is a configuration error (AuthConfigError).
# APPLE_BUNDLE_ID=<the iOS app's bundle id>
# APPLE_TEAM_ID=<10-char Apple developer team id>
# APPLE_KEY_ID=<Sign in with Apple key id>
# Contents of the .p8 key, newlines as \n, in double quotes
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# --- Anthropic (read by the SDK) ------------------------------------------------------
ANTHROPIC_API_KEY=<sk-ant-...>
# AGENT_MODEL=claude-haiku-5-5
# Store each agent turn's user message + state snapshot in agent_turns (eval capture); off by default.
# AGENT_CAPTURE_TURNS=1
